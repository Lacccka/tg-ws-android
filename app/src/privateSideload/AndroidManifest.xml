<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <service android:name=".service.ProxyForegroundService">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local user-started Telegram proxy that maintains a visible foreground notification and relays Telegram traffic through a local loopback proxy while the user keeps the proxy enabled" />
        </service>

        <activity
            android:name=".WorkerDiagnosticsActivity"
            android:exported="true"
            android:label="SE Worker Test">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WorkerPreferredEdgeActivity"
            android:exported="true"
            android:label="SE Edge Test">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WorkerTlsFragmentActivity"
            android:exported="true"
            android:label="SE TLS Frag Test">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WorkerFragmentedE2eActivity"
            android:exported="true"
            android:label="SE Worker Frag E2E">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WorkerNoSniE2eActivity"
            android:exported="true"
            android:label="SE Worker No-SNI E2E">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WorkerTlsMatrixActivity"
            android:exported="true"
            android:label="SE Worker TLS Matrix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
